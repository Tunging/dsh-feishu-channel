{
  "name": "@tunging/dsh-feishu",
  "description": "A dsh surface bundle: drive a DeepSeek Harness agent through a Feishu (Lark) bot via event subscription or long connection",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./autostart": {
      "default": "./lib/autostart.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "lib/autostart.js",
    "lib/utils.js",
    "lib/onboard.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "test": "node test/utils.test.js && node test/onboard.test.js"
  },
  "license": "MIT",
  "author": "Tunging",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunging/dsh-feishu-channel.git"
  },
  "homepage": "https://github.com/Tunging/dsh-feishu-channel#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "bot",
    "cordis",
    "channel"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "@larksuiteoapi/node-sdk": "^1.40.0",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": { "optional": true },
    "@deepseek-ai/dsh-user-questions": { "optional": true }
  }
}
